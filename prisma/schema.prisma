// FreeAll AI — Skema Database
// Dokumentasi: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // Tanpa ini, client hasil generate memakai import relatif tanpa ekstensi
  // (mis. "./enums"). Next.js bisa meresolusinya, tapi Node ESM tidak —
  // sehingga skrip di luar Next (prisma/seed.ts) gagal jalan.
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

/// Paket langganan. Menentukan batas-batas yang tidak bisa dinaikkan sendiri
/// oleh pengguna: jumlah API key, kuota Provider Publik, lama riwayat, dan
/// batas lonjakan per menit.
enum Plan {
  FREE
  PRO
  TEAM
}

/// Bagaimana sebuah tagihan dibayar.
enum PaymentMethod {
  /// Lewat Midtrans Snap — status ditentukan webhook, bukan halaman balik.
  MIDTRANS
  /// Transfer manual; pengguna mengunggah keterangan, admin yang mengonfirmasi.
  MANUAL
}

/// Perjalanan satu tagihan.
///
/// `AWAITING_REVIEW` hanya dipakai jalur manual: pengguna sudah mengaku
/// membayar, tetapi uangnya belum diverifikasi siapa pun. Dibedakan dari
/// `PENDING` supaya antrean kerja admin jelas isinya.
enum PaymentStatus {
  PENDING
  AWAITING_REVIEW
  PAID
  FAILED
  EXPIRED
  CANCELLED
}

/// Siapa yang boleh memakai sebuah ProviderKey.
///
/// Sengaja disimpan eksplisit, bukan diturunkan dari peran pemiliknya:
/// admin kadang perlu menyimpan kunci pribadi yang tidak dibagikan, user
/// biasa kadang ingin menyumbangkan kuncinya ke kolam bersama, dan
/// perubahan peran seseorang tidak boleh diam-diam mengubah akses kunci.
enum KeyScope {
  /// Hanya pemiliknya yang memakai kunci ini.
  PRIVATE
  /// Provider publik — dipakai semua user dan demo halaman depan.
  SHARED
}

/// Penyedia AI tambahan yang didaftarkan admin lewat dashboard.
///
/// Preset bawaan tetap hidup di kode karena membawa pola pengenalan kunci
/// (regex) yang dipakai deteksi otomatis. Tabel ini melengkapinya: penyedia
/// baru bisa ditambahkan tanpa deploy ulang, dan langsung muncul di halaman
/// depan maupun formulir pendaftaran kunci.
model CustomProvider {
  id           String   @id @default(uuid())
  /// Dipakai sebagai ProviderKey.providerName; huruf kecil tanpa spasi.
  slug         String   @unique
  label        String
  baseUrl      String
  defaultModel String
  /// "openai" | "gemini" | "anthropic"
  format       String   @default("openai")
  consoleUrl   String?
  free         Boolean  @default(false)
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Pengaturan aplikasi yang bisa diubah admin tanpa deploy ulang.
/// Disimpan sebagai pasangan kunci-nilai agar menambah pengaturan baru
/// tidak menuntut migrasi kolom setiap kali.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Pengguna web / pelanggan SaaS.
model User {
  id            String        @id @default(uuid())
  email         String        @unique
  name          String?
  passwordHash  String
  role          Role          @default(USER)
  plan          Plan          @default(FREE)
  /// Kapan paket berbayar berakhir. Null berarti tanpa masa berlaku
  /// (paket gratis, atau langganan seumur hidup yang diberikan admin).
  /// Lewat tanggal ini, akun otomatis dianggap kembali ke FREE.
  planExpiresAt DateTime?
  apiKeys       ApiKey[] // Kunci SaaS yang dibuat user untuk memakai gateway ini
  providerKeys  ProviderKey[] // Kunci AI (Groq/Gemini/dll) yang disumbangkan user
  sessions      Session[]
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

/// Sesi login dashboard. Cookie hanya membawa token mentah; DB menyimpan hash-nya.
model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Kunci otorisasi SaaS (sk-freeall-xxx) untuk memanggil /api/v1/chat.
/// Kunci mentah tidak pernah disimpan — hanya SHA-256-nya, jadi tidak bisa ditampilkan ulang.
model ApiKey {
  id         String       @id @default(uuid())
  name       String       @default("Default")
  keyHash    String       @unique
  keyPrefix  String // Potongan awal + akhir untuk ditampilkan di dashboard
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive   Boolean      @default(true)
  dailyLimit Int          @default(500)
  lastUsedAt DateTime?
  createdAt  DateTime     @default(now())
  logs       RequestLog[]

  @@index([userId])
}

/// Inti fallback: koleksi API key dari berbagai vendor AI.
/// Kunci mentah dienkripsi AES-256-GCM; keyHash dipakai untuk mencegah duplikat.
model ProviderKey {
  id             String    @id @default(uuid())
  providerName   String // "groq", "gemini", "deepseek", ...
  keyCiphertext  String
  keyHash        String    @unique
  keyPreview     String // "gsk_abc…9f2c"
  format         String    @default("openai") // "openai" | "gemini" | "anthropic"
  baseUrl        String? // Override endpoint; kosong = pakai preset provider
  modelName      String? // Model utama; kosong = pakai default preset
  /// Model cadangan pada kunci yang SAMA. Kuota gratis umumnya dihitung
  /// per model, jadi saat model utama kena 429 sering kali model lain di
  /// akun yang sama masih punya sisa jatah.
  fallbackModels String[]  @default([])
  userId         String? // Pemilik kunci; null hanya untuk kunci sistem
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope          KeyScope  @default(PRIVATE)
  isActive       Boolean   @default(true)
  priority       Int       @default(0) // Makin tinggi, makin awal dicoba
  errorCount     Int       @default(0)
  successCount   Int       @default(0)
  lastUsedAt     DateTime?
  lastErrorAt    DateTime?
  lastError      String?
  disabledReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive, priority])
  @@index([userId])
  @@index([scope, isActive])
}

/// Riwayat eksekusi. Dipakai untuk statistik dashboard dan penghitungan kuota harian.
model RequestLog {
  id            String   @id @default(uuid())
  apiKeyId      String?
  apiKey        ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  providerKeyId String?
  providerName  String?
  modelName     String?
  success       Boolean
  statusCode    Int?
  attempts      Int      @default(1)
  latencyMs     Int?
  errorMessage  String?
  source        String   @default("api") // "api" | "demo"
  createdAt     DateTime @default(now())

  @@index([apiKeyId, createdAt])
  @@index([createdAt])
}

/// Satu tagihan peningkatan paket.
///
/// Disimpan sebagai catatan tersendiri, bukan sekadar mengubah `User.plan`,
/// karena uang butuh jejak: berapa yang ditagih, lewat jalur apa, kapan lunas,
/// dan siapa yang menyetujuinya. Tanpa ini, sengketa pembayaran tidak bisa
/// ditelusuri dan pembukuan tidak punya sumber.
model Payment {
  id      String @id @default(uuid())
  /// Nomor pesanan yang dikirim ke Midtrans. Wajib unik seumur akun merchant,
  /// jadi dibuat dengan komponen acak — bukan nomor urut yang bisa ditebak.
  orderId String @unique
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Paket yang dibeli dan berapa lama masa berlakunya.
  plan         Plan
  durationDays Int
  /// Jumlah dalam rupiah penuh (bukan sen) — Midtrans memakai satuan ini.
  amount       Int

  method PaymentMethod
  status PaymentStatus @default(PENDING)

  /// Kanal yang benar-benar dipakai pembeli di Midtrans (mis. "gopay", "bca_va").
  channel         String?
  snapToken       String?
  snapRedirectUrl String?

  /// Keterangan dari pembeli pada jalur manual (nama pengirim, nomor referensi).
  payerNote  String?
  /// Alasan admin menolak, atau catatan saat menyetujui.
  adminNote  String?
  /// Admin yang memutuskan pada jalur manual. Sengaja bukan relasi: kalau
  /// akun admin dihapus, jejak siapa yang menyetujui tidak boleh ikut hilang.
  reviewedBy String?
  reviewedAt DateTime?

  paidAt    DateTime?
  /// Batas waktu tagihan. Lewat ini, tagihan tidak bisa dibayar lagi.
  expiresAt DateTime?

  /// Payload webhook terakhir, apa adanya. Dipakai saat menelusuri sengketa.
  lastNotification Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}
