// FreeAll AI — Skema Database
// Dokumentasi: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // Tanpa ini, client hasil generate memakai import relatif tanpa ekstensi
  // (mis. "./enums"). Next.js bisa meresolusinya, tapi Node ESM tidak —
  // sehingga skrip di luar Next (prisma/seed.ts) gagal jalan.
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

/// Pengguna web / pelanggan SaaS.
model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String?
  passwordHash String
  role         Role          @default(USER)
  apiKeys      ApiKey[] // Kunci SaaS yang dibuat user untuk memakai gateway ini
  providerKeys ProviderKey[] // Kunci AI (Groq/Gemini/dll) yang disumbangkan user
  sessions     Session[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

/// Sesi login dashboard. Cookie hanya membawa token mentah; DB menyimpan hash-nya.
model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Kunci otorisasi SaaS (sk-freeall-xxx) untuk memanggil /api/v1/chat.
/// Kunci mentah tidak pernah disimpan — hanya SHA-256-nya, jadi tidak bisa ditampilkan ulang.
model ApiKey {
  id         String       @id @default(uuid())
  name       String       @default("Default")
  keyHash    String       @unique
  keyPrefix  String // Potongan awal + akhir untuk ditampilkan di dashboard
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive   Boolean      @default(true)
  dailyLimit Int          @default(500)
  lastUsedAt DateTime?
  createdAt  DateTime     @default(now())
  logs       RequestLog[]

  @@index([userId])
}

/// Inti fallback: koleksi API key dari berbagai vendor AI.
/// Kunci mentah dienkripsi AES-256-GCM; keyHash dipakai untuk mencegah duplikat.
model ProviderKey {
  id             String    @id @default(uuid())
  providerName   String // "groq", "gemini", "deepseek", ...
  keyCiphertext  String
  keyHash        String    @unique
  keyPreview     String // "gsk_abc…9f2c"
  format         String    @default("openai") // "openai" | "gemini"
  baseUrl        String? // Override endpoint; kosong = pakai preset provider
  modelName      String? // Override model; kosong = pakai default preset
  userId         String? // Null jika ditambahkan Admin
  user           User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive       Boolean   @default(true)
  priority       Int       @default(0) // Makin tinggi, makin awal dicoba
  errorCount     Int       @default(0)
  successCount   Int       @default(0)
  lastUsedAt     DateTime?
  lastErrorAt    DateTime?
  lastError      String?
  disabledReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive, priority])
  @@index([userId])
}

/// Riwayat eksekusi. Dipakai untuk statistik dashboard dan penghitungan kuota harian.
model RequestLog {
  id            String   @id @default(uuid())
  apiKeyId      String?
  apiKey        ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  providerKeyId String?
  providerName  String?
  modelName     String?
  success       Boolean
  statusCode    Int?
  attempts      Int      @default(1)
  latencyMs     Int?
  errorMessage  String?
  source        String   @default("api") // "api" | "demo"
  createdAt     DateTime @default(now())

  @@index([apiKeyId, createdAt])
  @@index([createdAt])
}
